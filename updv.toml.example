[project]
name = "updv"
version = "0.1.0"
previous_version = "0.0.0"

[project.vars]
changelog_header = "Unreleased"

[project.files.initpy]
path = "src/{name}/__init__.py"
on-missing-file = "fail"
on-no-match = "fail"
enabled = true

pattern = "__version__ = \"{old}\""
replacement = "__version__ = \"{new}\""

[project.files.changelog]
path = "CHANGELOG.md"
on-missing-file = "fail"
on-no-match = "fail"
enabled = true

pattern = "## \\[{changelog_header}\\]"
replacement = "## [{new}] - {date}"

[project.files.version]
path = "VERSION"
on-missing-file = "create"
on-no-match = "write"
enabled = true

pattern = "{old}"
replacement = "{new}"
